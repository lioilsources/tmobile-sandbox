# Zkopíruj na witness.env (gitignored) a vyplň. Nic z toho nepatří do veřejného repa.
WITNESS_PUBLIC_IP=        # veřejná IP witness z portálu
WITNESS_VLAN_IP=10.10.0.2
L40S_VLAN_IP=10.10.0.10
VLAN_PREFIX=24
SSH_PUBKEY=               # obsah ~/.ssh/id_ed25519_witness.pub
SSH_PORT=22
# alerty: Telegram (bot od @BotFather + chat id) — prázdné = jen v UI Alertmanageru
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# heartbeat witness ven (healthchecks.io ping URL); prázdné = vypnuto
HEARTBEAT_URL=
GRAFANA_PASSWORD=
