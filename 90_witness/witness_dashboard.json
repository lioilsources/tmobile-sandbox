{
 "title": "Witness",
 "uid": "witness",
 "schemaVersion": 39,
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "refresh": "1m",
 "panels": [
  {
   "type": "stat",
   "title": "L40S dosažitelná (ping)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bool_yes_no",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "expr": "probe_success{job=\"ping\"}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Exportéry L40S nahoře",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "expr": "sum(up{host=\"ubuntu-l40s\"})",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Aktivní alerty",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "expr": "count(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}) or vector(0)",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "stat",
   "title": "Witness uptime",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "value"
   },
   "targets": [
    {
     "expr": "time() - node_boot_time_seconds{host=\"witness\"}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Witness CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never"
     },
     "max": 100
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{host=\"witness\",mode=\"idle\"}[5m])))",
     "legendFormat": "CPU %",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Witness RAM",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "node_memory_MemTotal_bytes{host=\"witness\"} - node_memory_MemAvailable_bytes{host=\"witness\"}",
     "legendFormat": "použito",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "expr": "node_memory_MemTotal_bytes{host=\"witness\"}",
     "legendFormat": "celkem",
     "refId": "B",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Witness disk volno",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "node_filesystem_avail_bytes{host=\"witness\",mountpoint=\"/\"}",
     "legendFormat": "/",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Sběr metrik (up)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 11,
    "w": 12,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never"
     },
     "max": 1
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "up",
     "legendFormat": "{{job}} {{instance}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Paměť kontejnerů monitoringu",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 24,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "min": 0,
     "custom": {
      "fillOpacity": 10,
      "lineWidth": 2,
      "showPoints": "never"
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    }
   },
   "targets": [
    {
     "expr": "process_resident_memory_bytes{host=\"witness\"}",
     "legendFormat": "{{instance}}",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ],
 "tags": [
  "witness"
 ]
}