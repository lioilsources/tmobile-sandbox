{
 "uid": "sandbox",
 "title": "L40S Sandbox",
 "tags": [
  "tmobile"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "schemaVersion": 39,
 "panels": [
  {
   "type": "gauge",
   "title": "GPU využití",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 5
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "yellow",
        "value": 70
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "expr": "DCGM_FI_DEV_GPU_UTIL",
     "legendFormat": "",
     "refId": "A",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "gauge",
   "title": "VRAM",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
